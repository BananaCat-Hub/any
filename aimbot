-- SLIDER LOGIC
local function UpdateStrength(screenX)
    local width = Slider.AbsoluteSize.X
    if width <= 0 then
        return
    end

    local relativeX = math.clamp(
        (screenX - Slider.AbsolutePosition.X) / width,
        0,
        1
    )

    Config.Strength = math.clamp(
        math.floor(relativeX * 100 + 0.5),
        1,
        100
    )

    local normalized = Config.Strength / 100
    Fill.Size = UDim2.new(normalized, 0, 1, 0)
    Knob.Position = UDim2.new(normalized, 0, 0.5, 0)
    Percentage.Text = string.format("%d%%", Config.Strength)
end

Percentage.Text = string.format("%d%%", Config.Strength)

local function IsPointerInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

SliderButton.InputBegan:Connect(function(input)
    if not IsPointerInput(input) then
        return
    end

    Sliding = true
    ActivePointer = input
    UpdateStrength(input.Position.X)
end)

-- TARGET VALIDATION
local function IsValidTarget(character)
    if not character or character == Player.Character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local part = character:FindFirstChild(Config.TargetPart)

    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    if not part or not part:IsA("BasePart") then
        return false
    end

    local targetPlayer = Players:GetPlayerFromCharacter(character)

    if targetPlayer then
        if Config.TeamCheck
            and Player.Team ~= nil
            and targetPlayer.Team == Player.Team then
            return false
        end
    elseif not Config.NPCCheck then
        return false
    end

    return true
end

-- VISIBILITY CHECK
local function IsVisible(character, part)
    if not Config.VisibilityCheck then
        return true
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        Player.Character,
    }

    local origin = Camera.CFrame.Position
    local direction = part.Position - origin
    local result = Workspace:Raycast(origin, direction, params)

    return result ~= nil and result.Instance:IsDescendantOf(character)
end

-- FIND CLOSEST TARGET
local function GetClosestTarget()
    local mousePosition = UserInputService:GetMouseLocation()
    local closestPart = nil
    local shortestDistance = Config.FOV

    local function CheckCharacter(character)
        if not IsValidTarget(character) then
            return
        end

        local part = character:FindFirstChild(Config.TargetPart)
        local screenPosition, onScreen =
            Camera:WorldToViewportPoint(part.Position)

        if not onScreen then
            return
        end

        local distance = (
            Vector2.new(screenPosition.X, screenPosition.Y) - mousePosition
        ).Magnitude

        if distance < shortestDistance and IsVisible(character, part) then
            shortestDistance = distance
            closestPart = part
        end
    end

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= Player then
            CheckCharacter(targetPlayer.Character)
        end
    end

    if Config.NPCCheck then
        for _, model in ipairs(Workspace:GetChildren()) do
            if model:IsA("Model")
                and not Players:GetPlayerFromCharacter(model) then
                CheckCharacter(model)
            end
        end
    end

    return closestPart
end

-- INPUT: AIM + PANEL DRAG
Connections.InputBegan = UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType == Config.AimKey and not processed then
        Aiming = true
    end
end)

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPosition = Panel.Position
        ActivePointer = input
    end
end)

Connections.InputChanged = UserInputService.InputChanged:Connect(function(input)
    if Sliding then
        local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
        local isTouchMove = ActivePointer
            and ActivePointer.UserInputType == Enum.UserInputType.Touch
            and input == ActivePointer

        if isMouseMove or isTouchMove then
            UpdateStrength(input.Position.X)
        end
    end

    if Dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - DragStart
        Panel.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + delta.Y
        )
    end
end)

Connections.InputEnded = UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Config.AimKey then
        Aiming = false
        CurrentTarget = nil
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Sliding = false
        Dragging = false
        ActivePointer = nil
    end
end)

-- MAIN AIM LOOP
Connections.Render = RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera
    if not Camera then
        return
    end

    FOVCircle.Position = UDim2.fromOffset(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )
    FOVCircle.Visible = Config.ShowFOV

    if not Config.Enabled or not Aiming then
        CurrentTarget = nil
        return
    end

    if not CurrentTarget
        or not CurrentTarget.Parent
        or not IsValidTarget(CurrentTarget.Parent) then
        CurrentTarget = GetClosestTarget()
    end

    if not CurrentTarget then
        return
    end

    -- 1% = very gradual, 100% = immediate camera alignment
    local alpha = math.clamp(Config.Strength / 100, 0.01, 1)
    local desiredCFrame = CFrame.lookAt(
        Camera.CFrame.Position,
        CurrentTarget.Position
    )

    Camera.CFrame = Camera.CFrame:Lerp(desiredCFrame, alpha)
end)

-- CLEANUP
Connections.Destroy = GUI.Destroying:Connect(function()
    Aiming = false
    Sliding = false
    Dragging = false
    CurrentTarget = nil

    for _, connection in pairs(Connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end
end)

print("[NOIR] Loaded. Hold RMB to aim; drag the slider to change strength.")
