-- BACKPACK / EQUIPPED TOOL SCANNER
-- Detects Tools and reports useful public attributes. It does not read or
-- execute hidden scripts, and does not modify server-controlled weapon logic.
local DetectedWeapons = {}
local ScannerConnections = {}

local function DescribeTool(tool)
    local details = {}
    for _, attributeName in ipairs({
        "Ammo", "CurrentAmmo", "MaxAmmo", "ClipSize",
        "ReloadTime", "FireRate", "Cooldown", "Recoil"
    }) do
        local value = tool:GetAttribute(attributeName)
        if value ~= nil then
            details[#details + 1] = attributeName .. "=" .. tostring(value)
        end
    end
    return #details > 0 and table.concat(details, ", ") or "no recognized attributes"
end

local function RegisterTool(item)
    if not item:IsA("Tool") then return end
    DetectedWeapons[item] = true
    print("[NOIR] Tool detected:", item:GetFullName(), "|", DescribeTool(item))
end

local function UnregisterTool(item)
    if item:IsA("Tool") then
        DetectedWeapons[item] = nil
        print("[NOIR] Tool removed:", item.Name)
    end
end

local function WatchContainer(container)
    if not container then return end
    for _, item in ipairs(container:GetChildren()) do
        RegisterTool(item)
    end
    ScannerConnections[#ScannerConnections + 1] = container.ChildAdded:Connect(RegisterTool)
    ScannerConnections[#ScannerConnections + 1] = container.ChildRemoved:Connect(UnregisterTool)
end

local function ScanPlayerWeapons()
    for tool in pairs(DetectedWeapons) do
        DetectedWeapons[tool] = nil
    end
    local backpack = Player:FindFirstChildOfClass("Backpack")
    WatchContainer(backpack)
    WatchContainer(Player.Character)
    local count = 0
    for tool in pairs(DetectedWeapons) do
        if tool.Parent then count += 1 end
    end
    print(string.format("[NOIR] Backpack scan complete: %d Tool(s) detected.", count))
end

ScanPlayerWeapons()
Player.CharacterAdded:Connect(function(character)
    task.wait(0.5)
    -- Rebind for the new character; disconnect old container listeners first.
    for _, connection in ipairs(ScannerConnections) do
        connection:Disconnect()
    end
    table.clear(ScannerConnections)
    ScanPlayerWeapons()
end)


local function IsCharacterBodyPart(part, character)
    if not part:IsA("BasePart") or part.Name == "HumanoidRootPart" then
        return false
    end

    -- Ignore accessory handles and equipped tool parts; outline body parts only.
    if part:FindFirstAncestorOfClass("Accessory")
        or part:FindFirstAncestorOfClass("Tool") then
        return false
    end

    return part:IsDescendantOf(character)
end

local function RemoveESP(player)
    local objects = ESPObjects[player]
    if objects then
        if objects.Billboard then
            objects.Billboard:Destroy()
        end

        for _, adornment in pairs(objects.Hitboxes or {}) do
            adornment:Destroy()
        end

        ESPObjects[player] = nil
    end
end

local function AddPartHitbox(player, part, objects)
    if objects.Hitboxes[part] then
        return
    end

    local hitbox = Instance.new("BoxHandleAdornment")
    hitbox.Name = "NoirLimbHitbox_" .. player.UserId .. "_" .. part.Name
    hitbox.Adornee = part
    hitbox.Size = part.Size
    hitbox.CFrame = CFrame.new()
    hitbox.AlwaysOnTop = true
    hitbox.ZIndex = 10
    hitbox.Transparency = 0.55
    hitbox.Color3 = Config.FOVColor
    hitbox.Parent = workspace

    objects.Hitboxes[part] = hitbox
end

local function CreateESP(player, character)
    if player == Player or not character then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local adornee = head or root
    if not root or not adornee then
        return
    end

    RemoveESP(player)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NoirPlayerESP_" .. player.UserId
    billboard.Adornee = adornee
    billboard.Size = UDim2.fromOffset(190, 34)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = Config.ESPMaxDistance
    billboard.LightInfluence = 0
    billboard.Parent = GUI

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.15
    label.Text = player.Name
    label.Parent = billboard

    local objects = {
        Billboard = billboard,
        Hitboxes = {},
    }
    ESPObjects[player] = objects

    -- Add a separate outline to every actual character body part.
    for _, descendant in ipairs(character:GetDescendants()) do
        if IsCharacterBodyPart(descendant, character) then
            AddPartHitbox(player, descendant, objects)
        end
    end
end

local function SetESPEnabled(enabled)
    Config.PlayerESP = enabled
    ESPButton.Text = enabled and "PLAYER ESP: ON" or "PLAYER ESP: OFF"
    ESPButton.TextColor3 = enabled and Config.FOVColor
        or Color3.fromRGB(205, 205, 215)
    ESPButton.BackgroundColor3 = enabled
        and Color3.fromRGB(30, 55, 65)
        or Color3.fromRGB(42, 44, 54)

    if enabled then
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= Player and targetPlayer.Character then
                CreateESP(targetPlayer, targetPlayer.Character)
            end
        end
    else
        for targetPlayer in pairs(ESPObjects) do
            RemoveESP(targetPlayer)
        end
    end
end

